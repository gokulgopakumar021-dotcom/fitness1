+import { describe, expect, it } from 'vitest';
+import {
+  MUSCLE_REGIONS,
+  MUSCLE_REGION_IDS,
+  getRegion,
+  getRegionLabel,
+  isMuscleRegionId,
+  regionsForView,
+  viewsForRegion,
+  type BodyView,
+} from './regions';
+
+describe('canonical muscle regions', () => {
+  it('defines exactly the eight V1 regions with stable ids and the specified labels', () => {
+    expect(MUSCLE_REGION_IDS).toEqual([
+      'chest', 'back', 'shoulders', 'arms', 'core', 'quadriceps', 'hamstrings_glutes', 'calves',
+    ]);
+    expect(MUSCLE_REGIONS.map((r) => r.label)).toEqual([
+      'Chest', 'Back / Lats', 'Shoulders', 'Arms', 'Core / Lower Back', 'Quadriceps', 'Hamstrings / Glutes', 'Calves',
+    ]);
+    expect(new Set(MUSCLE_REGION_IDS).size).toBe(8);
+  });
+
+  it('keeps ids independent of labels and in the same order as the region list', () => {
+    expect(MUSCLE_REGIONS.map((r) => r.id)).toEqual([...MUSCLE_REGION_IDS]);
+    for (const id of MUSCLE_REGION_IDS) {
+      expect(getRegion(id).id).toBe(id);
+      expect(getRegionLabel(id)).toBe(getRegion(id).label);
+      expect(id).not.toBe(getRegionLabel(id));
+    }
+  });
+
+  it('validates ids', () => {
+    for (const id of MUSCLE_REGION_IDS) expect(isMuscleRegionId(id)).toBe(true);
+    for (const bad of ['Chest', 'legs', '', null, undefined, 3, {}]) expect(isMuscleRegionId(bad)).toBe(false);
+  });
+
+  it('gives every region at least one drawable part in some view, and calves in both', () => {
+    for (const r of MUSCLE_REGIONS) {
+      expect(r.svgParts.front.length + r.svgParts.back.length).toBeGreaterThan(0);
+      expect(viewsForRegion(r.id).length).toBeGreaterThan(0);
+    }
+    expect(viewsForRegion('calves')).toEqual(['front', 'back']);
+  });
+
+  it('never assigns one svg part key to two different regions within a view', () => {
+    for (const view of ['front', 'back'] as BodyView[]) {
+      const owner = new Map<string, string>();
+      for (const r of MUSCLE_REGIONS) {
+        for (const part of r.svgParts[view]) {
+          expect(owner.get(part) ?? r.id).toBe(r.id);
+          owner.set(part, r.id);
+        }
+      }
+    }
+  });
+
+  it('lists which regions are visible per view (so the UI can say where to find the rest)', () => {
+    expect(regionsForView('front').map((r) => r.id)).toEqual(['chest', 'shoulders', 'arms', 'core', 'quadriceps', 'calves']);
+    expect(regionsForView('back').map((r) => r.id)).toEqual(['back', 'shoulders', 'arms', 'core', 'hamstrings_glutes', 'calves']);
+    // every region is reachable from at least one view
+    const all = new Set([...regionsForView('front'), ...regionsForView('back')].map((r) => r.id));
+    expect(all.size).toBe(8);
+  });
+});
diff --git a/src/utils/muscleMap/regions.ts b/src/utils/muscleMap/regions.ts
new file mode 100644
index 0000000..daa17bb
--- /dev/null
+++ b/src/utils/muscleMap/regions.ts
@@ -0,0 +1,73 @@
+/**
+ * Canonical regions for the Interactive Muscle Map (V1).
+ *
+ * IDs are stable and independent of display labels. The same IDs are used by the resolver,
+ * the training-load utilities, the map and the detail panel.
+ *
+ * Granularity note: logged workouts do not reliably separate biceps from triceps or
+ * hamstrings from glutes, so those pairs are single regions. Do not split them in the UI.
+ */
+
+export type BodyView = 'front' | 'back';
+
+export const MUSCLE_REGION_IDS = [
+  'chest',
+  'back',
+  'shoulders',
+  'arms',
+  'core',
+  'quadriceps',
+  'hamstrings_glutes',
+  'calves',
+] as const;
+
+export type MuscleRegionId = (typeof MUSCLE_REGION_IDS)[number];
+
+export interface MuscleRegion {
+  readonly id: MuscleRegionId;
+  /** Human-readable label shown in the UI. */
+  readonly label: string;
+  /**
+   * Stable SVG part keys that belong to this region, per body view. An empty array means the
+   * region is not visible from that view (the UI should say which view shows it).
+   */
+  readonly svgParts: Readonly<Record<BodyView, readonly string[]>>;
+}
+
+export const MUSCLE_REGIONS: readonly MuscleRegion[] = [
+  { id: 'chest', label: 'Chest', svgParts: { front: ['chest'], back: [] } },
+  { id: 'back', label: 'Back / Lats', svgParts: { front: [], back: ['upper-back', 'lats'] } },
+  { id: 'shoulders', label: 'Shoulders', svgParts: { front: ['front-delts'], back: ['rear-delts'] } },
+  { id: 'arms', label: 'Arms', svgParts: { front: ['biceps', 'forearms'], back: ['triceps', 'forearms'] } },
+  { id: 'core', label: 'Core / Lower Back', svgParts: { front: ['abs', 'obliques'], back: ['lower-back'] } },
+  { id: 'quadriceps', label: 'Quadriceps', svgParts: { front: ['quads'], back: [] } },
+  { id: 'hamstrings_glutes', label: 'Hamstrings / Glutes', svgParts: { front: [], back: ['glutes', 'hamstrings'] } },
+  { id: 'calves', label: 'Calves', svgParts: { front: ['calves-front'], back: ['calves-back'] } },
+];
+
+const BY_ID: Readonly<Record<MuscleRegionId, MuscleRegion>> = Object.fromEntries(
+  MUSCLE_REGIONS.map((r) => [r.id, r])
+) as Record<MuscleRegionId, MuscleRegion>;
+
+export function isMuscleRegionId(value: unknown): value is MuscleRegionId {
+  return typeof value === 'string' && (MUSCLE_REGION_IDS as readonly string[]).includes(value);
+}
+
+export function getRegion(id: MuscleRegionId): MuscleRegion {
+  return BY_ID[id];
+}
+
+export function getRegionLabel(id: MuscleRegionId): string {
+  return BY_ID[id].label;
+}
+
+/** Regions that have at least one drawable part in the given view. */
+export function regionsForView(view: BodyView): MuscleRegion[] {
+  return MUSCLE_REGIONS.filter((r) => r.svgParts[view].length > 0);
+}
+
+/** The view(s) in which a region is visible, front first. */
+export function viewsForRegion(id: MuscleRegionId): BodyView[] {
+  const r = BY_ID[id];
+  return (['front', 'back'] as const).filter((v) => r.svgParts[v].length > 0);
+}
diff --git a/src/utils/muscleMap/resolveRegion.test.ts b/src/utils/muscleMap/resolveRegion.test.ts
