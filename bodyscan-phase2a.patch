+  });
+});
+
+describe('config validation', () => {
+  it('defaults resolve unchanged and overrides with undefined values are ignored', () => {
+    expect(resolveCaptureQualityConfig()).toEqual(DEFAULT_CAPTURE_QUALITY_CONFIG);
