+});
+
+describe('retake', () => {
+  it('retaking runs a fresh analysis on the NEW photo and replaces the old result', async () => {
+    engine = createFakePoseEngine([{ ok: false, reason: 'no_pose' }, ok()]);
+    await giveConsent();
