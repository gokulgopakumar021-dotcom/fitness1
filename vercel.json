{
  "rewrites": [
    {
      "source": "/api/:__ironlog_api_path*",
      "destination": "/api"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/refund-policy",
      "destination": "/index.html"
    },
    {
      "source": "/cancellation-policy",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "hnd1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 120
    }
  }
}
