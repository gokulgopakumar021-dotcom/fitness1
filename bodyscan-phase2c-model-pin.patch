 const MIN_BYTES = 100_000; // keep in sync with MIN_MODEL_BYTES in src/services/poseLandmarker.ts
 
+// The model is pinned by content, not by URL: `latest` is a moving alias, so the bytes are only accepted if they
+// match this hash. To adopt a new model deliberately, run with `--expect <new sha256>`, then update these two
+// constants and the table in docs/body-scan-pose-model.md together (a test checks they agree).
+export const EXPECTED_SHA256 = '4eaa5eb7a98365221087693fcc286334cf0858e2eb6e15b506aa4a7ecdcec4ad';
+export const EXPECTED_BYTES = 9398198;
+
 const root = join(dirname(fileURLToPath(import.meta.url)), '..');
 const dest = join(root, 'public', 'models', `${VARIANT}.task`);
 const argIndex = process.argv.indexOf('--expect');
-const expected = argIndex > -1 ? process.argv[argIndex + 1]?.toLowerCase() : undefined;
+const expected = (argIndex > -1 ? process.argv[argIndex + 1] : EXPECTED_SHA256)?.toLowerCase();
 
 let res;
 try {
@@ -42,8 +48,9 @@ if (bytes.length < MIN_BYTES || bytes[0] === 0x3c /* '<' = a web page */) {
   process.exit(1);
 }
 const sha256 = createHash('sha256').update(bytes).digest('hex');
-if (expected && expected !== sha256) {
+if (expected !== sha256) {
   console.error(`SHA-256 mismatch.\n  expected ${expected}\n  actual   ${sha256}\nNothing was written.`);
+  console.error('The `latest` URL may now serve a different model. Do not use it until the new file has been reviewed; then pass --expect <new sha256> and update the pinned constants and docs.');
   process.exit(1);
 }
 
@@ -57,4 +64,4 @@ console.log(`Wrote ${dest}`);
 console.log(`  source : ${SOURCE}`);
 console.log(`  bytes  : ${bytes.length}`);
 console.log(`  sha256 : ${sha256}`);
-console.log('Record the bytes and sha256 in docs/body-scan-pose-model.md before committing the file.');
+console.log(`  pinned : ${sha256 === EXPECTED_SHA256 && bytes.length === EXPECTED_BYTES ? 'matches EXPECTED_SHA256 / EXPECTED_BYTES' : 'DIFFERS from EXPECTED_SHA256 / EXPECTED_BYTES: update them and the docs together'}`);
diff --git a/src/services/poseModel.integrity.test.ts b/src/services/poseModel.integrity.test.ts
new file mode 100644
index 0000000..7cf4dbc
--- /dev/null
+++ b/src/services/poseModel.integrity.test.ts
@@ -0,0 +1,42 @@
+import { createHash } from 'node:crypto';
+import { existsSync, readFileSync, statSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, expect, it } from 'vitest';
+
+// Keeps the pinned model record honest: the fetch script, the docs and (when present) the committed file must agree.
+const root = process.cwd();
+const script = readFileSync(join(root, 'scripts/fetch-pose-model.mjs'), 'utf8');
+const doc = readFileSync(join(root, 'docs/body-scan-pose-model.md'), 'utf8');
+const modelPath = join(root, 'public/models/pose_landmarker_full.task');
+
+const pinnedHash = /EXPECTED_SHA256 = '([0-9a-f]{64})'/.exec(script)?.[1];
+const pinnedBytes = Number(/EXPECTED_BYTES = (\d+)/.exec(script)?.[1]);
+
+describe('pose model pin', () => {
+  it('the fetch script pins a full SHA-256 and a byte size', () => {
+    expect(pinnedHash).toMatch(/^[0-9a-f]{64}$/);
+    expect(pinnedBytes).toBeGreaterThan(100_000);
+  });
+
+  it('the docs record the same hash and size as the script', () => {
+    expect(doc).toContain(pinnedHash!);
+    expect(doc).toContain(String(pinnedBytes));
+  });
+
+  it('the script refuses any download whose hash differs from the pin (no unverified write path)', () => {
+    expect(script).toMatch(/if \(expected !== sha256\)/);
+    expect(script).not.toMatch(/if \(expected && expected !== sha256\)/);
+  });
+
+  it('licence text and attribution ship with the repo', () => {
+    expect(existsSync(join(root, 'licenses/Apache-2.0.txt'))).toBe(true);
+    const notices = readFileSync(join(root, 'THIRD_PARTY_NOTICES.md'), 'utf8');
+    expect(notices).toContain('MediaPipe Pose Landmarker (BlazePose GHUM 3D), Google, Apache-2.0');
+  });
+
+  // Runs wherever the binary has been added. Absent file = skipped, so this proves nothing in a checkout without it.
+  it.skipIf(!existsSync(modelPath))('the committed model file matches the pinned size and SHA-256', () => {
+    expect(statSync(modelPath).size).toBe(pinnedBytes);
+    expect(createHash('sha256').update(readFileSync(modelPath)).digest('hex')).toBe(pinnedHash);
+  });
+});
