# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_FALLBACK_MODEL (optional, SERVER-SIDE ONLY: never prefix it with VITE_). Recovery on HTTP 503 / UNAVAILABLE only,
# at most 3 requests per generation inside one shared 90 s deadline: (1) primary model, (2) after a jittered 1-2 s wait, the
# primary once more, (3) ONE request to this model. 400/401/403/404/408/429/5xx-other are never retried. Unset =
# "gemini-3.5-flash-lite"; "off" = no fallback (the primary is still retried once); an invalid model id disables the fallback and
# logs one warning. Free Tier limits apply per project, not per key; a paid tier is not documented to remove 503s.
# GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase Auth (browser-safe values only) ---
# VITE_SUPABASE_URL: your project URL (Supabase dashboard -> Project Settings -> API).
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# VITE_SUPABASE_PUBLISHABLE_KEY: the *publishable* key (sb_publishable_...) or the legacy `anon` key.
# NEVER put the secret key, the service_role key or the database password in any VITE_* variable:
# Vite copies them into the public JavaScript bundle.
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# VITE_SITE_URL: the deployed origin that email links (verify / reset password) return to.
# Leave unset in local dev to use the current origin. Must also be listed in Supabase "Redirect URLs".
VITE_SITE_URL=""

# --- Server security (all optional; see docs/security/) ---
# The API verifies Supabase access tokens server-side. It reuses the VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY
# values above unless these are set. Never put a secret/service_role key here.
# SUPABASE_URL=""
# SUPABASE_PUBLISHABLE_KEY=""
# Comma-separated list of web origins allowed to call the API cross-origin (same-host requests need no entry).
# APP_URL and VITE_SITE_URL are added automatically. Never use "*".
# CORS_ALLOWED_ORIGINS="https://app.example.com"
# Opt in to Capacitor WebView origins (capacitor://localhost, https://localhost, http://localhost) when mobile ships.
# CORS_ALLOW_CAPACITOR="false"
# Number of reverse-proxy hops in front of Express (Cloud Run / Nginx = 1). Leave unset when not behind a proxy,
# otherwise per-IP limits see the proxy's address (or can be spoofed via X-Forwarded-For if set too high).
# TRUST_PROXY="1"
# Require a confirmed email address for API access (403 otherwise).
# AUTH_REQUIRE_VERIFIED_EMAIL="false"
# Rate limits (defaults: 300/min per IP, 120/min per user; 30 failed auths per 15 min per IP).
# RATE_LIMIT_IP_PER_MIN="300"
# RATE_LIMIT_USER_PER_MIN="120"
# AUTH_FAIL_MAX="30"
# AUTH_FAIL_WINDOW_SEC="900"
# Per-feature DAILY AI quota overrides (JSON; bucket names are in src/server/security/endpoints.ts). 0 disables a feature.
# AI_QUOTA_OVERRIDES='{"extract-plan":10,"ai-personal-trainer":100}'
# --- Daily AI quota store (see docs/security/quota-store.md) ---
# "supabase" (shared and restart-safe; the DEFAULT when NODE_ENV=production; requires migration
# 20261102045148_ai_usage_quota.sql and SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY) or "memory" (per process; the default
# in development). In production "memory" must be chosen explicitly and logs a warning that limits are not shared.
# An unrecognised value stops startup; it is never treated as "memory".
# QUOTA_STORE="memory"
# What happens when the shared quota store is unavailable: "closed" (default: 503 quota_unavailable, no Gemini call) or
# "degraded" (per-instance counting, X-Quota-Mode: degraded + logs; extract-plan and the physique routes still fail closed).
# QUOTA_FAILURE_POLICY="closed"
# --- Rate-limit store (see docs/security/rate-limiting-redis.md) ---
# "redis" (shared across instances; the DEFAULT when NODE_ENV=production) or "memory" (per process; the default in
# development). In production, "memory" must be chosen explicitly and logs a warning that limits are not shared.
# RATE_LIMIT_STORE="memory"
# Required when RATE_LIMIT_STORE=redis. Use rediss:// (TLS) for any non-local host. Treat it as a secret: never commit
# a real value, never prefix it with VITE_. The server refuses to start if Redis is configured but unreachable.
# REDIS_URL="rediss://default:YOUR_PASSWORD@your-redis-host:6380"
# What happens when Redis fails WHILE RUNNING. "closed" (default): protected requests get 503 rate_limit_unavailable.
# "degraded": limits count per instance and responses carry "X-RateLimit-Mode: degraded". extract-plan and both
# physique routes stay fail-closed in either mode.
# RATE_LIMIT_FAILURE_POLICY="closed"
# LOG_LEVEL="info"
# Client: API origin when the app is served from a different origin than the API (Capacitor builds).
# VITE_API_BASE_URL=""

# --- Billing / Razorpay (SERVER-SIDE ONLY: never prefix with VITE_; Test Mode keys only) ---
# All optional until billing is switched on. With any required value missing, /api/billing/* answers 503 billing_unavailable and the
# webhook processes nothing; every other route is unaffected. See docs/billing/STAGE2_NOTES.md.
# RAZORPAY_KEY_ID="rzp_test_REPLACE_ME"
# RAZORPAY_KEY_SECRET="REPLACE_ME"
# RAZORPAY_WEBHOOK_SECRET="REPLACE_ME"            # the secret you set on the webhook in the Razorpay dashboard
# RAZORPAY_PLAN_ID_MONTHLY="plan_REPLACE_ME"      # created once per mode by scripts/billing-create-plans.ts
# RAZORPAY_PLAN_ID_ANNUAL="plan_REPLACE_ME"
# SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"          # bypasses RLS: server only, never in a VITE_ variable, log or commit
# BILLING_TRIAL_PEPPER="REPLACE_WITH_32+_RANDOM_CHARS"   # HMAC secret for trial-claim email hashes; changing it resets claim matching
# Defaults shown; override only deliberately. The server refuses a checkout if the Razorpay plan amount differs from these.
# BILLING_PRICE_MONTHLY_PAISE="29900"
# BILLING_PRICE_ANNUAL_PAISE="149900"
# BILLING_TOTAL_COUNT_MONTHLY="120"
# BILLING_TOTAL_COUNT_ANNUAL="10"
# BILLING_TRIAL_DAYS="3"
# BILLING_AUTH_WINDOW_MINUTES="30"
# BILLING_PENDING_GRACE_HOURS="0"
# BILLING_RAZORPAY_TIMEOUT_MS="15000"
# BILLING_ENFORCEMENT="off"                       # off | shadow | on (used by Stage 3; nothing is gated in Stage 2)
# BILLING_ALLOW_LIVE_KEYS="false"                 # rzp_live_ keys are refused unless this is "true"
